<Window x:Class="Kirimise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kirimise">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Background" Value="#14223A"/>
                <Setter Property="BorderBrush" Value="#24385C"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#8FA3C4"/><Setter Property="CharacterSpacing" Value="80"/>
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="StatSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#8FA3C4"/>
            </Style>
            <Style x:Key="Th" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#8FA3C4"/><Setter Property="CharacterSpacing" Value="80"/>
            </Style>
            <Style x:Key="RowItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Padding="24,10" BorderBrush="#F4B942" BorderThickness="0,0,0,2">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Image x:Name="HeaderLogo" Height="64" Stretch="Uniform"/>
                    <TextBlock Text="Kirimise" FontSize="30" FontWeight="Black" Foreground="#FFF4DC" VerticalAlignment="Center" CharacterSpacing="120"/>
                    <Border x:Name="AdminBadge" Visibility="Collapsed" Background="#3FA7D6" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="ADMIN" FontWeight="Bold" FontSize="12" Foreground="#06121F"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserLabel" FontSize="16" Foreground="#FFF4DC" VerticalAlignment="Center"/>
                    <Button x:Name="ModeBtn" Click="ModeClick" Visibility="Collapsed" Content="Panel de administración"/>
                    <Button Content="Cerrar sesión" Click="LogoutClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ClientView" Grid.Row="1" Padding="20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CatBar" Orientation="Horizontal"/>
                </ScrollViewer>
                <GridView x:Name="MenuGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:Producto">
                            <Border Width="210" Height="310" Margin="6" CornerRadius="16"
                                    Background="#2A1B47" BorderBrush="#5B3E96" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="115"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="{x:Bind FondoBrush}">
                                        <Image Source="{x:Bind Imagen, Mode=OneWay}" Stretch="UniformToFill"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Padding="12,8,12,12" RowSpacing="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Nombre, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Foreground="#FFF4DC" TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Descripcion, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="{x:Bind PrecioText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#F4B942"/>
                                            <TextBlock Text="{x:Bind StockText, Mode=OneWay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Button Grid.Row="3" Content="Agregar" Tag="{x:Bind}" Click="AddClick" IsEnabled="{x:Bind Disponible, Mode=OneWay}"
                                                HorizontalAlignment="Stretch" Background="#C8283C" Foreground="White" Margin="0,4,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <Border Grid.Column="1" CornerRadius="18" Background="#1F1438" BorderBrush="#F4B942" BorderThickness="1" Padding="18">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Tu cuenta" FontSize="22" FontWeight="Bold" Foreground="#FFF4DC"/>
                    <TextBox x:Name="MesaBox" Grid.Row="1" Header="Mesa / puesto" Text="1" Width="180" HorizontalAlignment="Left" PlaceholderText="1 a 50"/>
                    <Grid Grid.Row="2">
                        <ListView x:Name="CartList" SelectionMode="None" ItemContainerStyle="{StaticResource RowItem}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CartLine">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind TotalText, Mode=OneWay}" Foreground="#F4B942" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="−" Tag="{x:Bind}" Click="MinusClick" Width="34"/>
                                        <Button Grid.Column="3" Content="+" Tag="{x:Bind}" Click="PlusClick" Width="34"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyText" Text="Tu cuenta está vacía&#10;Agrega algo del menú o pídele consejo a Kirimi."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.6"/>
                    </Grid>
                    <ComboBox x:Name="TipBox" Grid.Row="3" Header="Propina" SelectedIndex="0" SelectionChanged="TipChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Sin propina"/><ComboBoxItem Content="10%"/>
                        <ComboBoxItem Content="15%"/><ComboBoxItem Content="20%"/>
                    </ComboBox>
                    <StackPanel Grid.Row="4" Spacing="2">
                        <Grid><TextBlock Text="Subtotal"/><TextBlock x:Name="SubText" HorizontalAlignment="Right"/></Grid>
                        <Grid><TextBlock Text="IVA 16% incluido"/><TextBlock x:Name="IvaText" HorizontalAlignment="Right"/></Grid>
                        <Grid><TextBlock Text="Propina"/><TextBlock x:Name="TipText" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="TOTAL" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalText" FontSize="22" FontWeight="Bold" Foreground="#F4B942" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Vaciar" Click="ClearClick" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PayBtn" Grid.Column="1" Content="Cobrar" Click="PayClick" HorizontalAlignment="Stretch"
                                Background="#C8283C" Foreground="White" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AdminView" Grid.Row="1" Padding="24" RowSpacing="18" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Panel de administración" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="ReportBtn" Content="Exportar reporte de ventas" Click="ReporteClick" HorizontalAlignment="Right"
                        Background="#3FA7D6" Foreground="#06121F" FontWeight="SemiBold" Padding="16,8"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="#3FA7D6"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="PRODUCTOS" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="StatProd" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="StatProdSub" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="#3FB68B"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="VALOR DEL INVENTARIO" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="StatValor" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="StatValorSub" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="#F4B942"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="POR ABASTECER" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="StatBajo" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="StatBajoSub" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="#C8283C"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="VENTAS DE HOY" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="StatVentas" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="StatVentasSub" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Inventario" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox x:Name="AdminSearch" Grid.Column="1" PlaceholderText="Buscar producto" Width="200" TextChanged="AdminSearchChanged"/>
                            <Button Grid.Column="2" Content="Agregar" Click="AddProdClick" Background="#3FA7D6" Foreground="#06121F" FontWeight="SemiBold"/>
                            <Button Grid.Column="3" Content="Abastecer" Click="RestockClick"/>
                            <Button Grid.Column="4" Content="Cambiar imagen" Click="ChangeImgClick"/>
                            <Button Grid.Column="5" Content="Eliminar" Click="DeleteProdClick"/>
                        </Grid>
                        <Grid Grid.Row="1" Padding="8,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PRODUCTO" Style="{StaticResource Th}"/>
                            <TextBlock Grid.Column="2" Text="CATEGORÍA" Style="{StaticResource Th}"/>
                            <TextBlock Grid.Column="3" Text="PRECIO" Style="{StaticResource Th}"/>
                            <TextBlock Grid.Column="4" Text="STOCK" Style="{StaticResource Th}"/>
                        </Grid>
                        <ListView x:Name="AdminList" Grid.Row="2" SelectionMode="Single" ItemContainerStyle="{StaticResource RowItem}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Producto">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="60" Height="42" Background="{x:Bind FondoBrush}"><Image Source="{x:Bind Imagen, Mode=OneWay}" Stretch="UniformToFill"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Nombre, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Descripcion, Mode=OneWay}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Categoria, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind PrecioText, Mode=OneWay}" VerticalAlignment="Center" Foreground="#F4B942" FontWeight="SemiBold"/>
                                        <Border Grid.Column="4" Background="{x:Bind StockBrush, Mode=OneWay}" CornerRadius="10" Padding="10,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Stock, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#0B0614"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="18">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Por abastecer" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                            <Grid Grid.Row="1">
                                <ListView x:Name="BajosList" SelectionMode="None" ItemContainerStyle="{StaticResource RowItem}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:Producto">
                                            <Grid ColumnSpacing="10" Padding="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Nombre, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{x:Bind StockBrush, Mode=OneWay}" CornerRadius="10" Padding="10,2">
                                                    <TextBlock Text="{x:Bind StockText, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="#0B0614"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyBajos" Text="Todo con buen stock" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Ventas recientes" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                            <Grid Grid.Row="1">
                                <ListView x:Name="VentasList" SelectionMode="None" ItemContainerStyle="{StaticResource RowItem}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:Venta">
                                            <Grid ColumnSpacing="10" Padding="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Detalle}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind TotalText}" Foreground="#F4B942" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyVentas" Text="Aún no hay ventas" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel x:Name="ChatDock" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,470,24" Spacing="14" Visibility="Collapsed">
            <Border x:Name="ChatWindow" Width="390" Height="520" CornerRadius="18" Background="#1F1438"
                    BorderBrush="#F4B942" BorderThickness="1" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="18,18,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#9C1B2E" Offset="0"/><GradientStop Color="#4A0F3A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#1F1438" BorderBrush="#F4B942" BorderThickness="1">
                                <Image x:Name="ChatLogo" Margin="3" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Kirimi" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="#3FB68B" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mesera virtual · en línea" FontSize="12" Foreground="#FFD9DE"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Click="ChatMinClick" Background="Transparent" BorderThickness="0" Padding="10"
                                    ToolTipService.ToolTip="Minimizar">
                                <FontIcon Glyph="&#xE921;" FontSize="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="None" Padding="10,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ChatMsg">
                                <Border Background="{x:Bind Bubble}" HorizontalAlignment="{x:Bind Align}" MaxWidth="290"
                                        CornerRadius="14" Padding="12,8" Margin="0,2">
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10,0,10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="¡Hola!" Click="QuickClick" CornerRadius="14"/>
                            <Button Content="¿Qué me recomiendas?" Click="QuickClick" CornerRadius="14"/>
                            <Button Content="Algo sin picante" Click="QuickClick" CornerRadius="14"/>
                            <Button Content="Tengo mucha hambre" Click="QuickClick" CornerRadius="14"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" ColumnSpacing="8" Padding="10,0,10,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" MaxLength="200" PlaceholderText="Escríbele a Kirimi…" AcceptsReturn="False" KeyDown="ChatKeyDown" CornerRadius="16"/>
                        <Button x:Name="SendBtn" Grid.Column="1" Click="SendClick" Background="#C8283C" Foreground="White" CornerRadius="16" Padding="12,8">
                            <FontIcon Glyph="&#xE724;" FontSize="16"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid HorizontalAlignment="Right">
                <Button Click="ChatToggleClick" Width="64" Height="64" CornerRadius="32" Padding="0"
                        Background="#C8283C" BorderBrush="#F4B942" BorderThickness="2">
                    <FontIcon x:Name="FabIcon" Glyph="&#xE8BD;" FontSize="26" Foreground="White"/>
                </Button>
                <Border x:Name="Badge" Visibility="Collapsed" Width="22" Height="22" CornerRadius="11" Background="#F4B942"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False">
                    <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="Bold" Foreground="#2A1B2E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </StackPanel>

        <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing IsActive="True" Width="64" Height="64"/>
                <TextBlock x:Name="BusyText" Text="Procesando pago…" FontSize="20" Foreground="White"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoginPanel" Grid.RowSpan="2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3A0B2E" Offset="0"/>
                    <GradientStop Color="#0B0614" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Border Width="460" Padding="24" CornerRadius="20" Background="#1F1438" BorderBrush="#F4B942" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <Image x:Name="LoginLogo" Height="130" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="Entra, regístrate o pasa como invitado" Opacity="0.7" HorizontalAlignment="Center"/>
                    <Pivot Height="450">
                        <PivotItem Header="Iniciar sesión">
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <TextBox x:Name="LoginUser" Header="Usuario"/>
                                <PasswordBox x:Name="LoginPass" Header="Contraseña" MaxLength="20" KeyDown="LoginKeyDown"/>
                                <TextBlock x:Name="LoginErr" Foreground="Salmon" TextWrapping="Wrap"/>
                                <Button Content="Entrar" Click="LoginClick" HorizontalAlignment="Stretch" Background="#C8283C" Foreground="White"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem Header="Crear cuenta">
                            <ScrollViewer>
                                <StackPanel Spacing="10" Margin="0,8,12,8">
                                    <TextBox x:Name="RegName" Header="Nombre" MaxLength="12" PlaceholderText="Solo letras, máximo 12" BeforeTextChanging="NameBefore"/>
                                    <NumberBox x:Name="RegAge" Header="Edad" Minimum="1" Maximum="120" Value="18" SpinButtonPlacementMode="Inline" Width="160" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="RegUser" Header="Usuario" MaxLength="12" PlaceholderText="De 3 a 12: letras, números o _" BeforeTextChanging="UserBefore"/>
                                    <PasswordBox x:Name="RegPass" Header="Contraseña" PlaceholderText="De 6 a 20 con letras y números" MaxLength="20"/>
                                    <TextBox x:Name="RegMail" Header="Correo" MaxLength="100" PlaceholderText="Opcional, para tu ticket"/>
                                    <RadioButtons x:Name="RegRole" Header="Tipo de cuenta" SelectedIndex="0" SelectionChanged="RoleChanged" MaxColumns="2">
                                        <RadioButton Content="Normal"/>
                                        <RadioButton Content="Admin"/>
                                    </RadioButtons>
                                    <TextBlock x:Name="RegErr" Foreground="Salmon" TextWrapping="Wrap"/>
                                    <Button Content="Crear cuenta" Click="RegisterClick" HorizontalAlignment="Stretch" Background="#C8283C" Foreground="White"/>
                                </StackPanel>
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                    <Button Content="Continuar como invitado" Click="GuestClick" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Si te registras, Kirimi te reconoce y recuerda tus gustos." FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
